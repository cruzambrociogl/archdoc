# Binaries
/archdoc
/dist/
*.exe

# Go
*.test
*.out
/vendor/

# Frontend — built assets are generated, never committed.
# dist/.gitkeep is tracked so //go:embed all:dist compiles before the first frontend build.
/web/node_modules/
/web/dist/*
!/web/dist/.gitkeep

# archdoc's own output, if it is ever pointed at this repository
/.archdoc/

# Local
.DS_Store
*.local
.env

# ...except under testdata, where a .env is not ours. Fixtures stand in for other people's
# repositories, and archdoc reads their .env to resolve interpolation — a fixture without one
# cannot exercise the two-pass reconciliation.
!testdata/**/.env
